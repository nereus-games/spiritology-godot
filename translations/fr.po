msgid "TERM_ENERGY_NONE"
msgstr "aucune"

# Damage, and the two resources.
msgid "LOG_IMMUNE"
msgstr "%s est immunisé."

# %d = damage dealt, %s = who takes it.
msgid "LOG_DAMAGE"
msgstr "%d dégâts à %s."

msgid "LOG_ETH_DRAINED"

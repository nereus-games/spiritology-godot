msgid "TERM_FORLORN"
msgstr "Esseulé"

msgid "TERM_FORLORN_F"
msgstr "Esseulée"

msgid "TERM_FORLORN_PL"
msgstr "Esseulés"

# Dieverting (mécanisme de donjon) : annonce du jet. %d = la face sortie, %s = son effet.

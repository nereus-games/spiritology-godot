; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Spiritology"
config/description="Monster cataloger dungeon crawler RPG."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://assets/icon.svg"

[autoload]

GameData="*res://autoloads/game_data.gd"
GameSession="*res://autoloads/game_session.gd"
SaveSystem="*res://autoloads/save_system.gd"
TransitionManager="*res://autoloads/transition_manager.gd"

[display]

; Résolution de référence : c'est l'échelle à laquelle l'UI est dessinée, pas une
; limite de taille de fenêtre. En 1280x720 l'UI est "grossie" x1.5 sur un écran
; 1080p et x2.25 sur un 4K — le texte de rencontre reste lisible de loin.
window/size/viewport_width=1280
window/size/viewport_height=720
; 2 = MAXIMIZED : la fenêtre de jeu s'ouvre pleine taille d'entrée.
window/size/mode=2
; canvas_items : l'UI 2D est mise à l'échelle avec la fenêtre (sans stretch, elle
; resterait dessinée en pixels fixes minuscules sur un grand écran).
; expand : l'espace en plus est du vrai terrain gagné, pas des bandes noires.
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"


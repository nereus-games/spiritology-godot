# Traductions clés (mémoire projet) : spirimonster→spirimonstre, spiricosm→spiricosme,
# Gloom→Terne, Fiery→Ardent, Wonderful→Merveilleux.
# Les noms d'espèces (kalilk, érzélak…) sont des noms communs et NE se traduisent PAS.

msgid "UI_TITLE_NEW_GAME"
msgstr "Nouvelle partie"

msgid "UI_TITLE_CONTINUE"
msgstr "Continuer"

msgid "UI_TITLE_QUIT"
msgstr "Quitter"

# Menu d'action en rencontre. %s = nom du spirimonstre / nom de la capacité.
# CHOOSE_ACTION et CHOOSE_ABILITY prennent aussi l'ETH courant et max (%d/%d).
msgid "UI_ENCOUNTER_CHOOSE_ACTION"
msgstr "Que fait %s ? (ETH %d/%d)"

msgid "UI_ENCOUNTER_CHOOSE_ABILITY"
msgstr "Capacité de %s ? (ETH %d/%d)"

msgid "UI_ENCOUNTER_CHOOSE_OBJECT"
msgstr "Quel objet pour %s ?"

msgid "UI_ENCOUNTER_CHOOSE_TARGET"
msgstr "Cible de %s ?"

msgid "UI_ENCOUNTER_BACK"
msgstr "Retour"

# Actions de rencontre (doc : Talk, Examine, Use Ability, Use / Give Object, Meditate).
msgid "UI_ENCOUNTER_ACTION_TALK"
msgstr "Parler"

msgid "UI_ENCOUNTER_ACTION_EXAMINE"
msgstr "Examiner"

# Libellés courts : ils tiennent dans la barre d'actions horizontale du mockup
# (MEDITATE · CHALLENGE · TALK · EXAMINE · OBJECTS). Les intitulés longs vivent dans
# les invites CHOOSE_* ci-dessus.
msgid "UI_ENCOUNTER_ACTION_ABILITY"
msgstr "Défier"

msgid "UI_ENCOUNTER_ACTION_OBJECT"
msgstr "Objets"

msgid "UI_ENCOUNTER_ACTION_MEDITATE"
msgstr "Méditer"

# Action « … » : passer son tour quand plus rien n'est disponible. Pas de texte à traduire.
msgid "UI_ENCOUNTER_ACTION_PASS"
msgstr "…"

# Fuite : action ajoutée au menu par un talent / exécutée par une capacité (jamais de base).
msgid "UI_ENCOUNTER_ACTION_FLEE"
msgstr "Fuir"

# Vol : action ajoutée au menu par le talent Steal (granop), en remplacement de Talk.
msgid "UI_ENCOUNTER_ACTION_STEAL"
msgstr "Voler"

# Étiquettes d'énergie affichées sur les capacités dont l'énergie n'a pas d'icône.
msgid "UI_ENERGY_RANDOM"
msgstr "(aléatoire)"

msgid "UI_ENERGY_VARIABLE"
msgstr "(variable)"

# Coin haut-gauche de l'écran de rencontre.
msgid "UI_ENCOUNTER_LOG"
msgstr "JOURNAL"

msgid "UI_ENCOUNTER_MENU"
msgstr "MENU"

# Numéro de ronde, épinglé en tête du journal (hors défilement). %d = numéro.
msgid "UI_ENCOUNTER_TURN"
msgstr "Tour %d"


# gdlint configuration (gdtoolkit 4).
#
# The rules left active catch real regressions; the ones relaxed are relaxed for a written
# reason, and not to shut the tool up.
#
# class-definitions-order — DISABLED. The rule imposes a global order (signals, enums,
#   constants, variables, functions). This project deliberately groups each variable with
#   the constant it serves and the docstring that explains it; complying would scatter
#   blocks that read together. 96 reports, not one defect behind them.
#
# max-public-methods: 60 and max-returns: 10 — RAISED, not neutralised. At their defaults
#   (20 and 6) they flag exactly the files already known to be too big (dungeon_manager, 56
#   public methods; encounter_context, 49; rival_behavior.take_turn chains 9 guards at the
#   top of the function). The threshold sits just above what exists: it says nothing about
#   the past, but it blocks any WORSENING. To be brought back down once those files have
#   been split.
#
# signal-name — WIDENED to allow a `_` prefix. `UiAgent._submitted` is internal plumbing:
#   it is emitted by `submit()` and awaited by `decide()` in the same file, and the `_`
#   tells a reader not to connect to it from outside. Renaming it `submitted` would make it
#   look like an API. The author's convention beats code contorted to suit a tool.
#
# max-line-length stays at 100, comments included.

class-definitions-order:
- tools
- classnames
- extends
- docstrings
- signals
- enums
- consts
- staticvars
- exports
- pubvars
- prvvars
- onreadypubvars
- onreadyprvvars
- others
class-load-variable-name: (([A-Z][a-z0-9]*)+|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
class-name: ([A-Z][a-z0-9]*)+
class-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
comparison-with-itself: null
constant-name: _?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*
disable:
- class-definitions-order
duplicated-load: null
enum-element-name: '[A-Z][A-Z0-9]*(_[A-Z0-9]+)*'
enum-name: ([A-Z][a-z0-9]*)+
excluded_directories: !!set
  .git: null
expression-not-assigned: null
function-argument-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
function-arguments-number: 10
function-name: (_on_([A-Z][a-z0-9]*)+(_[a-z0-9]+)*|_?[a-z][a-z0-9]*(_[a-z0-9]+)*)
function-preload-variable-name: ([A-Z][a-z0-9]*)+
function-variable-name: '[a-z][a-z0-9]*(_[a-z0-9]+)*'
load-constant-name: (([A-Z][a-z0-9]*)+|_?[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)
loop-variable-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
max-file-lines: 1000
max-line-length: 100
max-public-methods: 60
max-returns: 10
mixed-tabs-and-spaces: null
no-elif-return: null
no-else-return: null
signal-name: _?[a-z][a-z0-9]*(_[a-z0-9]+)*
sub-class-name: _?([A-Z][a-z0-9]*)+
tab-characters: 1
trailing-whitespace: null
unnecessary-pass: null
unused-argument: null

msgid "UI_TITLE_NEW_GAME"
msgstr "New Game"

msgid "UI_TITLE_CONTINUE"
msgstr "Continue"

msgid "UI_TITLE_QUIT"
msgstr "Quit"

# Encounter action menu. %s = spirimonster name / ability name.
# CHOOSE_ACTION and CHOOSE_ABILITY also take current and max ETH (%d/%d).
msgid "UI_ENCOUNTER_CHOOSE_ACTION"
msgstr "What does %s do? (ETH %d/%d)"

msgid "UI_ENCOUNTER_CHOOSE_ABILITY"
msgstr "Which ability for %s? (ETH %d/%d)"

msgid "UI_ENCOUNTER_CHOOSE_OBJECT"
msgstr "Which object for %s?"

msgid "UI_ENCOUNTER_CHOOSE_TARGET"
msgstr "Target for %s?"

msgid "UI_ENCOUNTER_BACK"
msgstr "Back"

# Encounter actions (doc: Talk, Examine, Use Ability, Use / Give Object, Meditate).
msgid "UI_ENCOUNTER_ACTION_TALK"
msgstr "Talk"

msgid "UI_ENCOUNTER_ACTION_EXAMINE"
msgstr "Examine"

# Short labels: they fit the horizontal action bar from the mockup
# (MEDITATE · CHALLENGE · TALK · EXAMINE · OBJECTS). The long wording lives in the
# CHOOSE_* prompts above.
msgid "UI_ENCOUNTER_ACTION_ABILITY"
msgstr "Challenge"

msgid "UI_ENCOUNTER_ACTION_OBJECT"
msgstr "Objects"

msgid "UI_ENCOUNTER_ACTION_MEDITATE"
msgstr "Meditate"

# "…" action: pass the turn when nothing else is available. Nothing to translate.
msgid "UI_ENCOUNTER_ACTION_PASS"
msgstr "…"

# Flee: action added to the menu by a talent / executed by an ability (never a base action).
msgid "UI_ENCOUNTER_ACTION_FLEE"
msgstr "Flee"

# Steal: action added to the menu by the Steal talent (granop), replacing Talk.
msgid "UI_ENCOUNTER_ACTION_STEAL"
msgstr "Steal"

# Energy tags shown on abilities whose energy has no icon (random / variable each turn).
msgid "UI_ENERGY_RANDOM"
msgstr "(random)"

msgid "UI_ENERGY_VARIABLE"
msgstr "(variable)"

# Top-left corner of the encounter screen.
msgid "UI_ENCOUNTER_LOG"
msgstr "LOG"

msgid "UI_ENCOUNTER_MENU"
msgstr "MENU"

# Round number, pinned at the top of the log (stays put while scrolling). %d = number.
msgid "UI_ENCOUNTER_TURN"
msgstr "Turn %d"

# Encounter outcomes, as emitted by EncounterManager.ended.
msgid "UI_ENCOUNTER_RESULT_VICTORY"
msgstr "Encounter won"

msgid "UI_ENCOUNTER_RESULT_DEFEAT"
msgstr "Duo dissolved"

msgid "UI_ENCOUNTER_RESULT_TIMEOUT"
msgstr "The encounter peters out"

msgid "UI_ENCOUNTER_CONTINUE"
msgstr "Press to continue"

# "Forlorn" species variant. FR = "Esseulé" (agrees in gender/number; see fr.po).
msgid "TERM_FORLORN"
msgstr "Forlorn"

msgid "TERM_FORLORN_F"
msgstr "Forlorn"

msgid "TERM_FORLORN_PL"
msgstr "Forlorn"

# Dieverting (mécanisme de donjon) : annonce du jet. %d = la face sortie, %s = son effet.
msgid "UI_DIEVERTING_ROLL"
msgstr "The dieverting rolls a %d — %s"

msgid "UI_DIEVERTING_DESTROYED"
msgstr "Dieverting destroyed."

msgid "UI_DIEVERTING_ENTRANCE_OBJECTS"
msgstr "back to the entrance, and the objects lost stay behind in a chest"

msgid "UI_DIEVERTING_ENTRANCE_ETH"
msgstr "back to the entrance, and the duo loses ether"

msgid "UI_DIEVERTING_RIVALS"
msgstr "rivals spring up all around"

msgid "UI_DIEVERTING_EXIT_OBJECTS_DEN"
msgstr "off to an exit, objects left behind in a chest and density drained"

msgid "UI_DIEVERTING_DESTROY_OBJECTS"
msgstr "some objects crumble to dust"

msgid "UI_DIEVERTING_ADD_OBJECTS"
msgstr "objects are added to the inventory"

# Coffre (mécanisme de donjon). %s = la liste des objets trouvés.
msgid "UI_CHEST_LOOT"
msgstr "Found in the chest: %s"

# Choix offert par le talent Reveal Traps quand un coffre piégé tente de téléporter.
msgid "UI_ACTION_CHEST_TELEPORT"
msgstr "Let the chest teleport you"

msgid "UI_ACTION_CHEST_DECLINE"
msgstr "Stay put"


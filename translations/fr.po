msgstr "Les rivaux ont pris la fuite"

msgid "UI_ENCOUNTER_CONTINUE"
msgstr "Appuyez pour continuer"

# The "Forlorn" variant of a species — a "variété" in French, see the header. "Esseulé"
# agrees as needed: TERM_FORLORN is masculine singular, the feminine and plural forms

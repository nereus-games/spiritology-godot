# Comments are ENGLISH here as everywhere else in the repository; only the msgstr are
# French. What is in French below is the translation, never the note about it.
#
# Settled renderings: spirimonster -> spirimonstre, spiricosm -> spiricosme, Gloom -> Terne,
# Fiery -> Ardent, Wonderful -> Merveilleux. A spirimonster SPECIES is a "variété" in
# French, never an "espèce" — a point of lore, not of vocabulary.
# "round" and "turn" are BOTH "tour": French draws no distinction there, and "ronde" is
# wrong for either.
# Species names (kalilk, érzélak…) are common nouns and are NOT translated.

msgid "UI_TITLE_NEW_GAME"
msgstr "Nouvelle partie"

msgid "UI_TITLE_CONTINUE"
msgstr "Continuer"

msgid "UI_TITLE_QUIT"
msgstr "Quitter"

# Encounter action menu. %s = spirimonster name / ability name.
# CHOOSE_ACTION and CHOOSE_ABILITY also take current and max ETH (%d/%d).
msgid "UI_ENCOUNTER_CHOOSE_ACTION"
msgstr "Que fait %s ? (ETH %d/%d)"

msgid "UI_ENCOUNTER_CHOOSE_ABILITY"
msgstr "Capacité de %s ? (ETH %d/%d)"

msgid "UI_ENCOUNTER_CHOOSE_OBJECT"
msgstr "Quel objet pour %s ?"

msgid "UI_ENCOUNTER_CHOOSE_TARGET"
msgstr "Cible de %s ?"

# The object's target. Using it on a character and giving it to a rival are two different
# moves, and each option says which it is. %s = the object, then the target and its DEN.
msgid "UI_ENCOUNTER_USE_OR_GIVE"
msgstr "%s : l'utiliser sur un personnage, ou le donner à un rival ?"

msgid "UI_ENCOUNTER_USE_ON"
msgstr "Utiliser sur %s"

msgid "UI_ENCOUNTER_GIVE_TO"
msgstr "Donner à %s"

msgid "UI_ENCOUNTER_GIVE_HINT"
msgstr "Donner un objet à un rival est un geste en soi. Si l'objet agit sur une cible, il agit sur ce rival."

# The log's header for a Use / Give Object turn.
msgid "UI_ENCOUNTER_LOG_USE_OBJECT"
msgstr "Utilise un objet"

msgid "UI_ENCOUNTER_LOG_GIVE_OBJECT"
msgstr "Donne un objet"

msgid "UI_ENCOUNTER_BACK"
msgstr "Retour"

# Encounter actions (doc: Talk, Examine, Use Ability, Use / Give Object, Meditate).
msgid "UI_ENCOUNTER_ACTION_TALK"
msgstr "Parler"

msgid "UI_ENCOUNTER_ACTION_EXAMINE"
msgstr "Examiner"

# Short labels: they fit the horizontal action bar from the mockup
# (MEDITATE · CHALLENGE · TALK · EXAMINE · OBJECTS). The long wording lives in the
# CHOOSE_* prompts above.
msgid "UI_ENCOUNTER_ACTION_ABILITY"
msgstr "Défier"

msgid "UI_ENCOUNTER_ACTION_OBJECT"
msgstr "Objets"

msgid "UI_ENCOUNTER_ACTION_MEDITATE"
msgstr "Méditer"

# Static Camouflage: the choice offered at each group shown.
msgid "UI_ACTION_SCOUT_ENGAGE"
msgstr "Affronter ce groupe"

msgid "UI_ACTION_SCOUT_WAIT"
msgstr "Continuer d'attendre"

# %d = place of the group in the watch, %d = how many will be shown, %s = its makeup.
msgid "UI_SCOUT_GROUP"
msgstr "Groupe %d sur %d : %s"

# %d = how many individuals, %s = their species.
msgid "UI_SCOUT_MEMBER"
msgstr "%d x %s"

msgid "UI_SCOUT_NONE_LEFT"
msgstr "Il semble qu'aucun autre groupe ne rôde par ici."

# "…" action: pass the turn when nothing else is available. Nothing to translate.
msgid "UI_ENCOUNTER_ACTION_PASS"
msgstr "…"

# Flee: action added to the menu by a talent / executed by an ability (never a base action).
msgid "UI_ENCOUNTER_ACTION_FLEE"
msgstr "Fuir"

# Steal: action added to the menu by the Steal talent (granop), replacing Talk.
msgid "UI_ENCOUNTER_ACTION_STEAL"
msgstr "Voler"

# Energy tags shown on abilities whose energy has no icon (random / variable each turn).
msgid "UI_ENERGY_RANDOM"

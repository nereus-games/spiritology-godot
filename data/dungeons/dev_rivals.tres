spawn_points = Array[Vector3i]([Vector3i(1, 0, 7), Vector3i(7, 0, 7), Vector3i(1, 0, 11), Vector3i(7, 0, 11), Vector3i(4, 0, 12), Vector3i(4, 0, 7)])

# The Meditate action, always on offer in exploration (also counts towards a meditation gateway).
msgid "UI_ACTION_MEDITATE"
msgstr "Méditer"

# --- Exploration: the effect log and the status banner --------------------------------
# What an exploration ability or an object did, recorded by ExplorationContext, and the

msgstr "Le cubimprévu fait %d — %s"

msgid "UI_DIEVERTING_DESTROYED"
msgstr "Cubimprévu détruit."

msgid "UI_DIEVERTING_ENTRANCE_OBJECTS"
msgstr "retour à l'entrée, et les objets perdus restent dans un coffre"

msgid "UI_DIEVERTING_ENTRANCE_ETH"

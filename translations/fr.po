msgid "TERM_FORLORN"
msgstr "Esseulé"

msgid "TERM_FORLORN_F"
msgstr "Esseulée"

msgid "TERM_FORLORN_PL"
msgstr "Esseulés"

# Dieverting (a dungeon mechanism): the roll announced. %d = the face rolled, %s = its effect.

# --- The exploration test scenarios ---------------------------------------------------
# One title and one instruction sheet per `data/scenarios/*.tres`. The .tres carries only
# the id and the rank in the list; this is where the text lives.
msgid "SCENARIO_MOVEMENT_TITLE"
msgstr "Déplacement & regard"

msgid "SCENARIO_MOVEMENT_DESC"
msgstr "Salle vide avec piliers. Observe : fluidité du regard (souris), des rotations (Q/E) et du pas-à-pas (WASD). Échap libère le curseur."

msgid "SCENARIO_TRAPS_TITLE"
msgstr "Pièges (poison · téléport · disarray)"

msgid "SCENARIO_TRAPS_DESC"
msgstr "Marche sur les plaques. Violet = poison (le DEN baisse chaque tour). Bleu = téléport (tu changes de case). Orange = disarray (tes pas suivants partent parfois de travers)."

msgid "SCENARIO_GATES_TITLE"
msgstr "Portes (auto · verrouillée · méditation)"

msgid "SCENARIO_GATES_DESC"
msgstr "Les portes sont ENTRE deux cases (fines) : on peut se tenir de chaque côté. Grise = s'ouvre/ferme seule au fil des tours. Dorée = fais face + action « ouvrir » (paie 2 pelles). Verte = fais face + action « méditer » ×3, CONSÉCUTIVES (bouge ou détourne-toi et le compteur retombe à 0). Derrière la verte, un tas vert : ses actions n'apparaissent qu'une fois la porte ouverte — on n'agit pas sur ce qu'on ne voit pas."

msgid "SCENARIO_GROUNDS_TITLE"
msgstr "Sols spéciaux (Dig · Recycle · Examine)"

msgid "SCENARIO_GROUNDS_DESC"
msgstr "Sur la plaque terreuse : action « dig » (consomme 1 pelle → objet/info). Face au tas vert (obstacle) : actions « examine » et « recycle »."

msgid "SCENARIO_CHESTS_TITLE"
msgstr "Coffres · Cristal · Dieverting"

msgid "SCENARIO_CHESTS_DESC"
msgstr "Coffre doré = butin (ou téléport surprise : rien ne distingue un coffre piégé). Avec razél dans le duo (talent Reveal Traps), un coffre piégé propose « se laisser téléporter » ou « rester sur place » — du butin dans les deux cas, davantage en acceptant ; sans razél, il téléporte sec et sans rien donner. Cristal cyan (obstacle) = action « refresh » en face. Dés orange = effet aléatoire au contact : sur le premier tu as une pelle, donc le menu d'actions te propose « détruire » ou « subir » ; sur le second (pelle dépensée) le dé roule tout seul. Six issues possibles — renvoi à l'entrée ou à la sortie du fond, perte d'objets (déposés dans un coffre là où était le dé), perte d'ETH ou de DEN, apparition de rivaux, objets détruits ou gagnés."

msgid "SCENARIO_WALLS_TITLE"
msgstr "Mur fissuré · Décor examinable"

msgid "SCENARIO_WALLS_DESC"
msgstr "Face au mur sombre : action « cranny crossing » pour le traverser. Face au décor magenta : action « examine » (gain d'encyclopédie)."

msgid "SCENARIO_BRIDGE_TITLE"
msgstr "Pont étroit (équilibre)"

msgid "SCENARIO_BRIDGE_DESC"
msgstr "Entre sur la planche : une barre d'équilibre apparaît en haut. Corrige EN CONTINU avec A/D pour rester centré (sans rien faire, ou en corrigeant trop peu, une bourrasque te fait tomber). Chaque case franchie coûte un tour. Si tu tombes, tu atterris au fond du ravin (2 étages, dégâts de chute) et tu remontes au départ par les escaliers de droite. L'arrivée est une case unique murée, piégée au disarray : le retour se fait donc avec une commande latérale plus molle, et le compteur de disarray descend d'un cran par case de pont."

msgid "SCENARIO_BRIDGE_RIVAL_TITLE"
msgstr "Pont étroit + rival"

msgid "SCENARIO_BRIDGE_RIVAL_DESC"
msgstr "Même ravin, avec un rival de l'AUTRE côté : il doit prendre le pont pour t'atteindre, donc vous vous croisez forcément sur une planche. Il a son propre test d'équilibre (1 à 2 % de chute par case, tiré à sa création) et peut donc tomber tout seul en venant. Si vous vous croisez, vous tombez tous les deux sur la même case et la rencontre s'engage en bas. Et s'il t'a vu chuter, il peut sauter à ta suite."

msgid "SCENARIO_STAIRS_TITLE"
msgstr "Escaliers, ascenseurs & chutes (5 étages)"

msgid "SCENARIO_STAIRS_DESC"
msgstr "Pyramide de cinq gradins. Un escalier bleu par palier (0→1→2→3→4), en quinconce vers le fond : c'est le chemin toujours praticable. Les plateformes orange sont des RACCOURCIS doublant ces escaliers — un ascenseur VERTICAL (1↔2) et un à trajet COMPLEXE (3↔4) qui sort au-dessus du vide et enchaîne des segments sur les trois axes. Un ascenseur reste où on l'a laissé : s'il est resté en haut, reprends l'escalier. Pour les chutes : à l'ouest chaque gradin surplombe le suivant (1 unité = aucun dégât) ; à l'est (dernière colonne) rien n'arrête avant le bas (1/2/3/4 unités = 0/10/15/20 DEN). En bas, tu peux marcher SOUS les gradins — et un PILIER y soutient un coin du gradin 1 : sa face haute est directement le sol du dessus, sans dalle ajoutée. Au sommet, les deux premières cases du bord est sont protégées par une RAMBARDE (basse : on voit le vide par-dessus, mais on ne le franchit pas) ; deux pas plus loin le même bord est ouvert, et fait tomber de 4 étages."

msgid "SCENARIO_ABILITIES_TITLE"
msgstr "Capacités & objets d'exploration"

msgid "SCENARIO_ABILITIES_DESC"
msgstr "Dans le menu d'actions (Tab/Espace) : utilise « fog mantel » (le rival cesse de te suivre) ou « tea drop » (soigne le poison du piège)."

# --- The encounter log ---------------------------------------------------------------
# One line per thing an action or an ability effect does, as the LOG panel shows it. The
# manager prefixes each with the individual's name, so these lines start mid-sentence and
# never repeat the subject.
#
# "[to come]" marks a mechanic the engine cannot express yet: the line says what WOULD have
# happened, so the ability is visible while the system it needs is missing. See
# docs/roadmap.md.
#
# %s is a spirimonster's name unless the comment says otherwise, and ORDER IS LOAD-BEARING:
# GDScript's % takes its arguments positionally.

# The line that opens the log. TERM_ENCOUNTER is bold on its own, so the punctuation that
# follows it lives here — French puts a space before a colon, English does not.
# %s = the player characters, %s = the rivals, both comma-separated.
msgid "TERM_ENCOUNTER"
msgstr "Rencontre"

msgid "LOG_ENCOUNTER_OPENING"
msgstr " : %s contre %s"

# How a log line is ASSEMBLED, which is punctuation and therefore translatable: French puts
# a space before a colon and English does not. %s = the individual's name, %s = the ability
# id when there is one, %s = the line itself.
msgid "LOG_LINE"
msgstr "%s · %s"

msgid "LOG_LINE_ABILITY"
msgstr "%s · %s : %s"

# A talent's line rather than a turn's: the mark is what tells the two apart. %s = the line.
msgid "LOG_LINE_TALENT"
msgstr "⁘ %s"

# The encyclopaedia gain appended under a turn. %d = the IFP earned, %s = the species.
msgid "LOG_LINE_IFP"
msgstr "+%d IFP — %s"

# Energy names spelled out. The turn order shows icons; the log has only words. These
# flow inside a sentence, hence lower case; the label form lives in LOG_RESTRICT_*.
msgid "TERM_ENERGY_HEAT"
msgstr "chaleur"

msgid "TERM_ENERGY_FLUID"
msgstr "fluide"

msgid "TERM_ENERGY_CRYSTAL"
msgstr "cristal"

msgid "TERM_ENERGY_ARCANE"
msgstr "arcane"

msgid "TERM_ENERGY_TOXIC"
msgstr "toxique"

msgid "TERM_ENERGY_RANDOM"
msgstr "aléatoire"

msgid "TERM_ENERGY_VARIABLE"
msgstr "variable"

msgid "TERM_ENERGY_NONE"
msgstr "aucune"

# Damage, and the two resources.
msgid "LOG_IMMUNE"
